# OrangeFox recovery init for OPPO OP4F97 (MT6765)
#  - USB gadget: adb / MTP / sideload / fastbootd via configfs
#  - Trustonic TEE + keymaster/gatekeeper bring-up for FBE decryption

on early-init
    start ueventd

on init
    export PATH /sbin:/system/bin
    export ANDROID_ROOT /system
    export ANDROID_DATA /data
    export EXTERNAL_STORAGE /sdcard
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64

    symlink /proc/self/fd/0 /dev/stdin
    symlink /proc/self/fd/1 /dev/stdout
    symlink /proc/self/fd/2 /dev/stderr
    symlink /system/etc /etc

    # binder (required by hwservicemanager / HALs)
    mkdir /dev/binderfs
    mount binder binder /dev/binderfs stats=global
    chmod 0755 /dev/binderfs
    symlink /dev/binderfs/binder /dev/binder
    symlink /dev/binderfs/hwbinder /dev/hwbinder
    symlink /dev/binderfs/vndbinder /dev/vndbinder
    chmod 0666 /dev/binderfs/binder
    chmod 0666 /dev/binderfs/hwbinder
    chmod 0666 /dev/binderfs/vndbinder

    mount configfs none /config

    mkdir /sdcard
    mkdir /external_sd
    mkdir /usb_otg
    mkdir /system
    mkdir /data
    mkdir /cache
    mkdir /sideload
    mkdir /mnt/system
    mount tmpfs tmpfs /tmp size=80%
    chown root shell /tmp
    chmod 0775 /tmp

    # media storage for MTP
    mkdir /sdcard/Android 0771 media_rw media_rw
    mkdir /sdcard/DCIM 0770 media_rw media_rw
    mkdir /sdcard/Pictures 0770 media_rw media_rw
    mkdir /sdcard/Movies 0770 media_rw media_rw
    mkdir /sdcard/Download 0770 media_rw media_rw

    # persist (TEE needs it)
    mkdir /mnt/vendor/persist
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist rw
    mkdir /mnt/vendor/persist/mcRegistry

    # create functionfs mounts used by USB
    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mkdir /dev/usb-ffs/mtp 0770 shell shell
    mkdir /dev/usb-ffs/fastboot 0770 system system
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    mount functionfs mtp /dev/usb-ffs/mtp uid=2000,gid=2000
    mount functionfs fastboot /dev/usb-ffs/fastboot rmode=0770,fmode=0660,uid=1000,gid=1000

on fs
    # set up configfs gadget (composite: adb + mtp)
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x2A70
    mkdir /config/usb_gadget/g1/strings/0x409 0770
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /config/usb_gadget/g1/functions/ffs.fastboot
    mkdir /config/usb_gadget/g1/configs/b.1 0777 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb,mtp"

    write /sys/class/power_supply/usb/otg_switch 1

on boot
    class_start core

# USB functions.
on property:sys.usb.config=adb && property:sys.usb.ffs.ready=1
    write /config/usb_gadget/g1/idProduct 0xD001
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state adb
    start adbd

on property:sys.usb.config=mtp && property:sys.usb.ffs.ready=1
    write /config/usb_gadget/g1/idProduct 0x4EE1
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state mtp

on property:sys.usb.config=mtp,adb && property:sys.usb.ffs.ready=1
    write /config/usb_gadget/g1/idProduct 0x4EE2
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state mtp,adb
    start adbd

on property:sys.usb.config=sideload && property:sys.usb.ffs.ready=1
    write /config/usb_gadget/g1/idProduct 0xD001
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state sideload
    start adbd

on property:sys.usb.config=fastboot && property:sys.usb.ffs.ready=1
    write /config/usb_gadget/g1/idProduct 0x4EE0
    symlink /config/usb_gadget/g1/functions/ffs.fastboot /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state fastboot
    start fastbootd

# Services.
service ueventd /system/bin/ueventd
    critical
    seclabel u:r:recovery:s0

service adbd /system/bin/adbd --root_seclabel=u:r:recovery:s0 --device_banner=recovery
    disabled
    socket adbd stream 660 system system
    seclabel u:r:recovery:s0

service recovery /system/bin/recovery
    socket recovery stream 422 system system
    seclabel u:r:recovery:s0

service fastbootd /system/bin/fastbootd
    disabled
    group system
    seclabel u:r:recovery:s0

# Trustonic TEE daemons (required for keymaster / FBE)
service mobicore /vendor/bin/mcDriverDaemon --P1 /mnt/vendor/persist/mcRegistry \
    -r /vendor/app/mcRegistry/020f0000000000000000000000000000.drbin \
    -r /vendor/app/mcRegistry/05120000000000000000000000000000.drbin \
    -r /vendor/app/mcRegistry/020b0000000000000000000000000000.drbin \
    -r /vendor/app/mcRegistry/06090000000000000000000000000000.drbin \
    -r /vendor/app/mcRegistry/9073f03a9618383bb1856eb3f990babd.drbin \
    seclabel u:r:recovery:s0

service hwservicemanager /system/bin/hwservicemanager
    onrestart setprop hwservicemanager.ready false
    seclabel u:r:recovery:s0

service vndservicemanager /vendor/bin/vndservicemanager /dev/vndbinder
    seclabel u:r:recovery:s0

service servicemanager /system/bin/servicemanager
    group system readproc
    seclabel u:r:recovery:s0

service keymaster-4-0 /system/bin/android.hardware.keymaster@4.0-service.trustonic
    user root
    group root drmrpc
    seclabel u:r:recovery:s0

service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    user root
    group root
    seclabel u:r:recovery:s0

service hal_cryptoeng_oppo /system/bin/hw/vendor.oplus.hardware.cryptoeng@1.0-service
    user root
    group root
    seclabel u:r:recovery:s0

# start TEE + HALs once hwservicemanager is up
on property:hwservicemanager.ready=true
    start mobicore
    start vndservicemanager
    start servicemanager
    start keymaster-4-0
    start vendor.gatekeeper-1-0
    start hal_cryptoeng_oppo

# stop the crypto stack once decryption has completed
on property:twrp.decrypt.done=true
    stop mobicore
    stop keymaster-4-0
    stop vendor.gatekeeper-1-0
    stop hal_cryptoeng_oppo

on property:ro.crypto.state=unsupported
    stop mobicore
    stop keymaster-4-0
    stop vendor.gatekeeper-1-0
    stop hal_cryptoeng_oppo

on property:ro.crypto.state=unencrypted
    stop mobicore
    stop keymaster-4-0
    stop vendor.gatekeeper-1-0
    stop hal_cryptoeng_oppo