# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# mount point       fstype    device                                        flags

# --- Dynamic (mapper) partitions ---
/system             ext4      /dev/block/mapper/system                      flags=display="System";backup=1
/vendor             ext4      /dev/block/mapper/vendor                      flags=display="Vendor";backup=1
/product            ext4      /dev/block/mapper/product                     flags=display="Product";backup=1
/odm                ext4      /dev/block/mapper/odm                          flags=display="ODM";backup=1

# --- Physical/by-name partitions ---
/boot               emmc      /dev/block/by-name/boot                        flags=display="Boot";backup=1
/recovery           emmc      /dev/block/by-name/recovery                    flags=display="Recovery";backup=1
/cache              ext4      /dev/block/by-name/cache                       flags=display="Cache"
/dtbo               emmc      /dev/block/by-name/dtbo                        flags=display="DTBO";backup=1;flashimg=1
/vbmeta             emmc      /dev/block/by-name/vbmeta                      flags=display="VBMeta";backup=1;flashimg=1
/vbmeta_system      emmc      /dev/block/by-name/vbmeta_system               flags=display="VBMeta System";backup=1;flashimg=1
/vbmeta_vendor      emmc      /dev/block/by-name/vbmeta_vendor               flags=display="VBMeta Vendor";backup=1;flashimg=1
/misc               emmc      /dev/block/by-name/para                        flags=display="Misc";backup=1
/nvram              emmc      /dev/block/by-name/nvram                       flags=backup=1;display="NVRAM"
/proinfo            emmc      /dev/block/by-name/proinfo
/logo               emmc      /dev/block/by-name/logo                        flags=display="Boot Logo";backup=1
/bootloader         emmc      /dev/block/by-name/lk                          flags=display="Bootloader"
/bootloader2        emmc      /dev/block/by-name/lk2                         flags=display="Bootloader2"
/tee1               emmc      /dev/block/by-name/tee1
/tee2               emmc      /dev/block/by-name/tee2
/expdb              emmc      /dev/block/by-name/expdb                        flags=backup=1
/seccfg             emmc      /dev/block/by-name/seccfg                       flags=backup=1
/custom             ext4      /dev/block/by-name/odm                          flags=display="Custom"

# --- TWRP Android-related ---
/storage            f2fs      /data/media/0                                  flags=display="Internal Storage";backup=1;usermrf;fsflags="bind";removable

# --- External Storage ---
/sdcard1           auto      /dev/block/mmcblk1p1    /dev/block/mmcblk1      flags=display="MicroSD Card";storage;wipeingui;removable
/usb_otg           vfat      /dev/block/sda1         /dev/block/sdd          flags=display="USB-Storage";storage;wipeingui;removable